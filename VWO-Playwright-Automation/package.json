{
  "name": "vwo-playwright-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript POM framework for the VWO (Wingify) login page",
  "scripts": {
    "install:browsers": "playwright install chromium firefox webkit",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:valid": "playwright test tests/login-valid.spec.ts",
    "test:invalid": "playwright test tests/login-invalid.spec.ts",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:clean": "node -e \"for (const d of ['allure-results','allure-report','test-results']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "report": "npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "3.14.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  }
}
